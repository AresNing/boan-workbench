# Copy to .env and configure locally. Never commit .env or credentials.
# npm run demo requires no configuration.
WORKBENCH_PROJECT=/absolute/path/to/your/project
WORKBENCH_PROVIDER=anthropic
WORKBENCH_MODEL=claude-sonnet-4-5
# Use WORKBENCH_API_KEY or the provider's standard environment variable.
# WORKBENCH_API_KEY=
# Optional OpenAI-compatible API base URL and model ID:
# WORKBENCH_BASE_URL=http://127.0.0.1:8000/v1
# WORKBENCH_MODEL=your-model-id
# Optional independent verification command (subject to command permissions):
# WORKBENCH_VERIFY_COMMAND=npm test
# WORKBENCH_DATA_DIR=/absolute/path/to/workbench-state
# WORKBENCH_MAX_TURNS=30
# WORKBENCH_RUN_TIMEOUT_MS=3600000
# PORT=4317
